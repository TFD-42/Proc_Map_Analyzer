# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Virtual environment (created by install.sh / install.ps1) -------------
.venv/
.venv-build/
venv/
env/

# --- PyInstaller build artifacts (see README, build section) ---------------
build/
dist/
*.spec

# --- Outputs generated at runtime (real data from the user's machine:
# PID, paths, IP, possibly network connections — must never be
# committed) -----------------------------------------------------------------
outputs/
process_graph_3d*.html
process_graph*.png
process_data*.json
*.csv
rapport_*.md
history.json
integrity.json
big.md
big.csv

# --- Any real-capture export, whatever the future format (defensive: the
# tool doesn't export GIFs today, but if it ever does, block it here too) ---
*.gif
*.mp4

# --- Curated banner/demo media is the one exception: hand-made assets for
# the README/social preview, never generated from a real capture ------------
!assets/
!assets/**

# --- Demo files with non-anonymized real data (see
# secret-scan-report.md): to be regenerated with clean data before any
# publication, never to be committed as-is -----------------------------
demo_data.json
demo_graph.png
demo_graph_3d.html

# --- Editors / OS ------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp

# --- Internal working reports (promo audit, not published) ---------------
promotion-report.md

# --- Local Claude session artifacts (dead-code backups, etc.) ---------------
.claude/
